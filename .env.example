# Biến môi trường cho docker-compose.yml (B6.4-T4)
#
# Cách dùng:
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (macOS / Linux)
# rồi thay các giá trị bên dưới bằng giá trị THẬT của riêng bạn.
#
# File `.env` đã nằm trong .gitignore — không bao giờ commit nó lên Git.
#
# ---------------------------------------------------------------------------
# VÌ SAO MỌI BIẾN ĐỀU CÓ TIỀN TỐ `QLSKDD_`
#
# Docker Compose ưu tiên biến môi trường CỦA MÁY cao hơn file .env này. Nhiều thành viên đã
# set sẵn `DB_PASSWORD` trên máy để chạy backend ở chế độ dev; nếu compose đọc đúng tên đó
# thì giá trị bạn ghi ở đây bị bỏ qua hoàn toàn mà không có cảnh báo nào — container MySQL sẽ
# nhận mật khẩu của MySQL trên máy, và bạn chỉ phát hiện khi vào container thấy sai mật khẩu.
# Tiền tố `QLSKDD_` để không còn khả năng trùng tên với biến của máy.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Mật khẩu root của container MySQL. Đây là MySQL RIÊNG do Docker tạo, hoàn toàn tách biệt
# với MySQL cài trên máy bạn — nên cứ đặt mật khẩu mới, không cần trùng mật khẩu máy thật.
#
# LƯU Ý: mật khẩu chỉ được áp dụng ở LẦN TẠO volume ĐẦU TIÊN. Đổi giá trị này sau đó mà không
# xoá volume thì MySQL vẫn giữ mật khẩu cũ và backend sẽ báo "Access denied".
# Đổi mật khẩu thì phải dựng lại volume:  docker compose down -v && docker compose up -d
QLSKDD_DB_PASSWORD=doi-mat-khau-nay-di

# Tên database (không cần đổi)
QLSKDD_DB_NAME=qlsk_dd

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Khoá ký JWT. PHẢI sinh khoá mới, đừng dùng lại khoá dev trong application.yml.
# Sinh khoá bằng một trong các lệnh sau:
#   node  -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
QLSKDD_JWT_SECRET=sinh-khoa-moi-bang-lenh-o-tren

# Hạn của access token, tính bằng mili-giây (mặc định 24 giờ)
QLSKDD_JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------------
# Spring profile
# ---------------------------------------------------------------------------
# `prod,demo` (mặc định) — cấu hình chạy thật + DemoSeeder nạp sẵn tài khoản và sự kiện,
#                          dùng cho demo và cho người mới clone về muốn xem ngay.
# `prod`                 — database RỖNG HOÀN TOÀN, không có tài khoản nào nên KHÔNG ĐĂNG NHẬP
#                          ĐƯỢC. Chỉ chọn khi triển khai thật và bạn sẽ tự tạo admin đầu tiên.
QLSKDD_SPRING_PROFILES=prod,demo

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Để RỖNG là đúng cho cấu hình Docker mặc định: frontend gọi API qua nginx theo đường dẫn
# tương đối `/api/v1` nên cùng origin, trình duyệt không gửi request cross-origin nào.
# Chỉ điền khi có client ở tên miền khác cần gọi API, phân tách bằng dấu phẩy:
#   QLSKDD_CORS_ALLOWED_ORIGINS=https://qlskdd.example.com,http://localhost:5173
QLSKDD_CORS_ALLOWED_ORIGINS=
